<?xml version="1.0" encoding="UTF-8" ?>
<!--
  FastDDS profile that disables shared-memory transport. Required when this
  container subscribes to TRANSIENT_LOCAL topics (e.g. /tf_static) published
  by a host process running outside the container. The container's UDS/SHM
  mounts are not visible to host publishers, so SHM transport silently fails
  for latched messages; UDPv4 works because the container shares the host's
  network stack via network_mode: host.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

    <transport_descriptors>
        <transport_descriptor>
            <transport_id>udp_transport</transport_id>
            <type>UDPv4</type>
        </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="participant_profile" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>udp_transport</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
        </rtps>
    </participant>

</profiles>
